{
  "name": "topcharge/php-sdk",
  "description": "Official PHP SDK for the TopCharge merchant API.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.1",
    "ext-json": "*"
  },
  "autoload": {
    "psr-4": {
      "TopCharge\\SDK\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "TopCharge\\SDK\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "php tests/run.php",
    "test:integration": "php tests/integration.php"
  }
}
